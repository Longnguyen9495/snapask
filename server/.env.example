APP_NAME=SnapAsk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mặc định `log`: máy dev ghi thư ra storage/logs thay vì gửi thật.
#
# Thư xác thực email và thư đặt lại mật khẩu đều đi qua đây, nên trên máy chủ
# thật phải điền một SMTP có thật. Với Gmail thì MAIL_PASSWORD là App Password
# 16 ký tự lấy trong phần bảo mật của tài khoản Google, không phải mật khẩu
# đăng nhập — Gmail đã chặn mật khẩu thường từ lâu.
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=ban@gmail.com
#   MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
#
# MAIL_FROM_ADDRESS phải trùng MAIL_USERNAME, nếu không Gmail sẽ đổi lại địa chỉ
# gửi và thư dễ rơi vào spam.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SNAPASK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
SNAPASK_API_KEY=
SNAPASK_MODEL=qwen-vl-plus
SNAPASK_IMAGE_RETENTION_DAYS=14
SNAPASK_RESEND_IMAGE=true
SNAPASK_MCP_TIMEOUT=20
SNAPASK_MCP_MAX_RESULT_CHARS=6000

# Bắt tài khoản mới xác thực email. Bỏ trống thì chỉ bật khi APP_ENV=production,
# và lúc đó phải cấu hình MAIL_* ở trên bằng một SMTP thật.
# SNAPASK_VERIFY_EMAIL=true

# Bản phát hành cho trang tải về. Để trống thì trang nói thẳng là chưa có bản
# dựng, và /download/{platform} trả 404.
#
# Điền *_URL thì người tải được chuyển thẳng sang đó (GitHub Releases, CDN);
# để trống thì file được lấy từ storage/app/releases/.
SNAPASK_RELEASE_VERSION=0.1.0
SNAPASK_RELEASE_DATE=
SNAPASK_RELEASE_WIN_FILE=
SNAPASK_RELEASE_WIN_URL=
SNAPASK_RELEASE_WIN_SIZE=
SNAPASK_RELEASE_WIN_SHA256=
SNAPASK_RELEASE_MAC_FILE=
SNAPASK_RELEASE_MAC_URL=
SNAPASK_RELEASE_MAC_SIZE=
SNAPASK_RELEASE_MAC_SHA256=
