{
    "name": "snapask-desktop",
    "version": "0.3.0",
    "description": "Chụp một vùng màn hình rồi hỏi AI ngay tại chỗ.",
    "main": "src/main/main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "dist": "npm run dist:win",
        "dist:win": "electron-builder --win nsis --publish never",
        "dist:mac": "electron-builder --mac dmg --publish never",
        "icons": "node build/make-icon.js",
        "i18n:check": "node build/check-i18n.js && node build/find-i18n-keys.js",
        "vendor": "node build/sync-vendor.js",
        "test": "node --test \"test/*.test.js\"",
        "check": "node build/check-syntax.js && node build/sync-vendor.js --check && npm run i18n:check && npm test"
    },
    "build": {
        "appId": "vn.snapask.desktop",
        "productName": "SnapAsk",
        "artifactName": "SnapAsk-Setup-${version}-${os}-${arch}.${ext}",
        "publish": {
            "provider": "generic",
            "url": "https://snapask.vn/updates"
        },
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "src/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "SnapAsk",
            "deleteAppDataOnUninstall": false
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "icon": "build/icon.icns",
            "category": "public.app-category.productivity",
            "hardenedRuntime": true,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSScreenCaptureUsageDescription": "SnapAsk cần quyền ghi màn hình để chụp vùng bạn chọn.",
                "LSUIElement": false
            }
        }
    },
    "devDependencies": {
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "chart.js": "^4.5.1",
        "electron-updater": "^6.6.2"
    }
}
