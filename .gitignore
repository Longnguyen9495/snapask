# Cơ sở dữ liệu SQLite chứa tài khoản thật và lịch sử hội thoại — Laravel không
# tự bỏ qua file này.
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Bộ cài đã đóng gói, dựng lại được bằng `npm run dist`.
dist/

node_modules/
vendor/

# Thư viện của bên thứ ba mà renderer nạp thẳng bằng thẻ <script>.
#
# Nằm ngoài luật `vendor/` ở trên: CSP chỉ cho `script-src 'self'` nên không lấy
# được từ CDN, mà desktop lại không có bước đóng gói nào — thiếu file này trong
# repo là bản dựng ra lò không có biểu đồ. Đồng bộ bằng `npm run vendor`.
!desktop/src/renderer/vendor/
!desktop/src/renderer/vendor/**

.DS_Store
Thumbs.db

# Symlink do trình cài skill tạo, trỏ bằng đường dẫn tuyệt đối của máy này nên
# commit vào là hỏng ở máy khác. Skill thật nằm trong .agents/skills/.
.claude/
